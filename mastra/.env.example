# --- e2a -------------------------------------------------------------------
# Account (e2a_acct_) or agent (e2a_agt_) key from your e2a dashboard.
E2A_API_KEY=

# The inbox this agent owns and sends as.
E2A_AGENT_EMAIL=support@your-domain.example

# Signing secret for the webhook endpoint you point at POST /webhooks/e2a.
# Shown once when you create the webhook.
E2A_WEBHOOK_SECRET=whsec_

# Optional. Defaults to https://api.e2a.dev — set this only when self-hosting.
# E2A_API_URL=

# --- model -----------------------------------------------------------------
# Any id from Mastra's model router: provider/model-name. No provider package
# needed. Default below is what this template was tested against.
#
# CAVEAT: model ids go stale, and availability is per-account. Mastra's own docs
# still show google/gemini-2.5-flash, which now returns "no longer available to
# new users". If a model 404s or is refused, list what your key can actually
# reach rather than assuming the template is broken:
#   curl -H "x-goog-api-key: $KEY" \
#     'https://generativelanguage.googleapis.com/v1beta/models?pageSize=200'
#
#   google/gemini-3.6-flash   (tested)   anthropic/claude-sonnet-4-6
#   openai/gpt-5-mini                    xai/grok-4.3
MODEL=google/gemini-3.6-flash

# Set only the key for the provider you chose above — Mastra picks it up by name.
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
