{
  "name": "e2a-mastra",
  "version": "0.1.0",
  "description": "A deployable Mastra agent with a real email inbox, powered by e2a \u2014 verified inbound mail over webhooks, replies in-thread, and a human approval gate before the agent sends.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "mastra",
    "e2a",
    "ai-agents",
    "email",
    "human-in-the-loop",
    "agent-infrastructure"
  ],
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@e2a/sdk": "^5.6.0",
    "@mastra/core": "latest",
    "@mastra/libsql": "latest",
    "@mastra/memory": "latest",
    "supports-color": "^10.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "mastra": "latest",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
