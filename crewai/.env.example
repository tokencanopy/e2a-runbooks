# e2a — https://e2a.dev
E2A_API_KEY=e2a_acct_your_key_here
E2A_WEBHOOK_SECRET=whsec_your_signing_secret_here

# The four agent identities this desk runs. Each must already exist as an e2a
# agent on this account — the app refuses to start otherwise, because a send
# from a non-existent address fails only after the crew has already run.
#
# The front desk receives everything. Replies go out from the specialist desk
# that owns the issue, so a customer's follow-up reaches that desk directly.
FRONT_DESK_EMAIL=support@your-domain.example
BILLING_DESK_EMAIL=billing@your-domain.example
TECHNICAL_DESK_EMAIL=tech@your-domain.example
SECURITY_DESK_EMAIL=security@your-domain.example

# Model. CrewAI picks the provider from the prefix.
#   anthropic/…  claude-…  claude/…   -> needs crewai[anthropic]  (in requirements.txt)
#   gpt-…        openai/…             -> no extra needed
#   gemini/…                          -> needs crewai[google-genai]
MODEL=anthropic/claude-opus-5
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional: set when self-hosting e2a.
# E2A_API_URL=https://api.e2a.dev
