# --- e2a -------------------------------------------------------------------
# Account (e2a_acct_) or agent (e2a_agt_) key from your e2a dashboard.
E2A_API_KEY=

# The inbox contracts are emailed to.
E2A_AGENT_EMAIL=contracts@your-domain.example

# Signing secret for the webhook you point at POST /webhooks/e2a.
E2A_WEBHOOK_SECRET=whsec_

# Optional. Defaults to https://api.e2a.dev — set only when self-hosting.
# E2A_API_URL=

# --- model -----------------------------------------------------------------
# LangChain model string: "provider:model". Defaults to anthropic:claude-opus-5.
MODEL=anthropic:claude-opus-5
ANTHROPIC_API_KEY=
