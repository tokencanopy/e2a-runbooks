# --- e2a -------------------------------------------------------------------
# Use an AGENT-scoped key (e2a_agt_) here on purpose: agent keys cannot list or
# approve reviews (that is account scope), so this agent physically cannot
# approve its own held send.
E2A_API_KEY=e2a_agt_

# The inbox this agent owns. Point your monitoring alerts at it.
E2A_AGENT_EMAIL=sre-agent@your-domain.example

# Signing secret for the webhook you point at POST /webhooks/e2a.
E2A_WEBHOOK_SECRET=whsec_

# Where triage notes go once a human approves them.
ONCALL_EMAIL=oncall@your-domain.example

# Optional. Defaults to https://api.e2a.dev — set only when self-hosting.
# E2A_API_URL=

# --- model -----------------------------------------------------------------
ANTHROPIC_API_KEY=
MODEL=claude-opus-5
