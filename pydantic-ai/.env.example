# e2a — https://e2a.dev
E2A_API_KEY=e2a_agt_your_key_here
E2A_AGENT_EMAIL=scheduling@your-domain.example
E2A_WEBHOOK_SECRET=whsec_your_signing_secret_here

# Who the secretary schedules for. There is no calendar: this window is the
# entirety of what the agent knows about availability, so keep it accurate.
PRINCIPAL_NAME=Dr. Reyes
TIMEZONE=America/Los_Angeles
AVAILABILITY=Monday to Friday, 09:00-17:00, excluding 12:00-13:00
MEETING_MINUTES=30

# Required. Anything the agent cannot handle — off-topic mail, attendee or
# location changes, a stuck negotiation, a manipulation attempt — is emailed
# here. The agent's reply tells the sender a human will follow up, so a human
# has to actually receive it.
HANDOFF_EMAIL=you@your-domain.example

# Model. Pydantic AI resolves the provider from the `provider:model` prefix.
#   anthropic:…   openai:…   google:…   (google-cloud:… for Vertex)
# Match the extra in requirements.txt to whichever you pick.
MODEL=anthropic:claude-opus-5
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional: set when self-hosting e2a.
# E2A_API_URL=https://api.e2a.dev
