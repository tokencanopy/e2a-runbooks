# e2a — https://e2a.dev
#
# The API key must be able to read and write CONTACTS, not just messages. An
# agent-scoped key can drive its own outreach records; the account-level
# contact methods (create, import) need account scope. This runbook creates
# contacts, so use an account-scoped key.
E2A_API_KEY=e2a_acct_your_key_here
E2A_AGENT_EMAIL=purchasing@your-domain.example
E2A_WEBHOOK_SECRET=whsec_your_signing_secret_here

# Required. Every escalation lands here: a supplier whose terms breach a
# threshold, a PO that ran out of follow-ups, an email the agent can't match to
# an order. The supplier is told a person will pick it up, so a person has to.
BUYER_EMAIL=you@your-domain.example

# Appears in the signature on every outbound email.
COMPANY_NAME=Acme Goods

# Required. POST /tick and POST /orders/{po}/open both send mail, so they are
# not endpoints the open internet should be able to trigger. Any long random
# string; send it as the x-tick-token header.
TICK_TOKEN=change-me-to-a-long-random-string

# ── Policy ──────────────────────────────────────────────────────────────────
# These thresholds are the entire difference between an agent that closes a PO
# and one that escalates it. They are applied in Python, never by the model, so
# a persuasive supplier email cannot move them.

# Accept a short shipment up to this percentage of the ordered quantity.
MAX_SHORTFALL_PCT=5
# Accept a ship date this many days past the need-by date.
MAX_SLIP_DAYS=3
# Accept a unit price increase up to this percentage.
MAX_PRICE_INCREASE_PCT=2

# How many unanswered follow-ups before the agent gives up and emails BUYER_EMAIL,
# and how many days it waits between them.
MAX_CHASES=3
CHASE_INTERVAL_DAYS=3

# Model. Anthropic here; to switch providers, change the package in
# requirements.txt and the import at the top of chase.py.
MODEL=claude-opus-5
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional: set when self-hosting e2a.
# E2A_API_URL=https://api.e2a.dev
